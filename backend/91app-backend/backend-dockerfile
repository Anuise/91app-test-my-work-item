FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["91app-backend/91app-backend.csproj", "91app-backend/"]
RUN dotnet restore "91app-backend/91app-backend.csproj"
COPY . .
WORKDIR /src/91app-backend
RUN dotnet publish "91app-backend.csproj" -c Release -o /app/publish --no-restore /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app/publish .
USER $APP_UID
EXPOSE 8080
ENTRYPOINT ["dotnet", "91app-backend.dll"]
