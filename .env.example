# 複製本檔為 .env 以覆寫本機 PostgreSQL 容器設定（.env 已被 .gitignore 忽略，不會進版控）。
# 這裡的值僅為本機開發預設值，非正式環境秘密；正式環境請改用部署平台的環境變數注入。
POSTGRES_DB=my_work_item
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# 對外映射的主機埠；若變更，請同步更新 backend/91app-backend/appsettings.Development.json 的連線字串。
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
JWT_ISSUER=MyWorkItem.Api
JWT_AUDIENCE=MyWorkItem.Web
JWT_KEY=demo-only-jwt-signing-key-change-before-production
CORS_ORIGIN=http://localhost:3000
API_BASE_URL=http://backend:8080
NEXT_PUBLIC_PASSWORD_SALT=MyWorkItem-System-Salt-v1
AUTH_COOKIE_SECURE=false
